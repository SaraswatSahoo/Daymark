# Copy to .env and adjust. Never commit .env.

# PostgreSQL. Locally: `docker compose up -d` (docker-compose.yml) and keep these defaults.
# On Vercel + Neon: DATABASE_URL = Neon's *pooled* connection string (host contains
# "-pooler"), DIRECT_URL = the direct one. Both end in ?sslmode=require.
DATABASE_URL="postgresql://daymark:daymark@localhost:5434/daymark"
DIRECT_URL="postgresql://daymark:daymark@localhost:5434/daymark"

# Optional: protect the app with a password (strongly recommended whenever the app is
# reachable from anything other than localhost). Leave empty for local-only use.
APP_PASSWORD=""
# Optional: secret used to sign the session cookie. Defaults to a value derived from APP_PASSWORD.
SESSION_SECRET=""

# Optional AI features (Groq only). Leave GROQ_API_KEY empty to disable AI entirely.
# Get a key at https://console.groq.com/keys — keep it server-side only.
GROQ_API_KEY=""
# A production text model from https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-20b"

# Optional web push (notifications while the app is closed). Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Only needed on serverless hosts (Vercel): protects /api/cron/push, which an external
# cron calls every minute to send push reminders. Generate with: openssl rand -hex 32
CRON_SECRET=""
